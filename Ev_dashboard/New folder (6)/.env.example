EULER_URL=https://eulerlogistics.com/vehicles
EULER_USERNAME=your_username
EULER_PASSWORD=your_password

# 10 minutes by default
POLL_INTERVAL_SECONDS=600
HEADLESS=true
UNIFIED_GOOGLE_SHEET_NAME=Unified Vehicle Snapshots
UNIFIED_POLL_INTERVAL_SECONDS=600

# Recommended production output. Use "supabase" for fast dashboard reads.
SCRAPER_STORAGE=sheets
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_VEHICLE_TABLE=vehicles
SUPABASE_SNAPSHOT_TABLE=vehicle_snapshots

INTELLICAR_URL=https://track.intellicar.in/
INTELLICAR_USERNAME=your_username
INTELLICAR_PASSWORD=your_password
INTELLICAR_POLL_INTERVAL_SECONDS=600
INTELLICAR_SOCKET_TIMEOUT_SECONDS=60
INTELLICAR_GOOGLE_SHEET_NAME=Unified Vehicle Snapshots
INTELLICAR_GOOGLE_WORKSHEET_GID=
INTELLICAR_CSV_PATH=data/intellicar_vehicle_records.csv

# Optional. If omitted, scraper writes to CSV in data/euler_vehicle_records.csv
GOOGLE_SHEET_ID=
GOOGLE_WORKSHEET_GID=
GOOGLE_SHEET_NAME=Unified Vehicle Snapshots
GOOGLE_SERVICE_ACCOUNT_JSON=

# If GOOGLE_SERVICE_ACCOUNT_JSON is blank, the scraper auto-detects a
# service-account JSON file in this folder.
