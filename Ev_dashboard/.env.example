# Server / app configuration
PORT=3001
GOOGLE_SHEET_ID=
GOOGLE_SHEET_GID=
GOOGLE_APPLICATION_CREDENTIALS=./service_account.json
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAP_ID=
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_NAME=Admin User
AUTH_REQUIRED=true

# Supabase (server-side use SERVICE_ROLE for server processes)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: enable using Supabase instead of Google Sheets
USE_SUPABASE=false

# Mail / OTP dev mode
OTP_DEV_MODE=true
PORT=3001
GOOGLE_APPLICATION_CREDENTIALS=./service_account.json
GOOGLE_SHEET_ID=1_A58jO3bLmeZor0kwjNFaypqRGpW9KG0EOirrU9rbjA
GOOGLE_SHEET_GID=912727605
ALERT_RECIPIENTS_SHEET_NAME=Alert Recipients
AUTH_USERS_SHEET_NAME=Users
ALERT_LOG_SHEET_NAME=Alert Log
CLIENT_HUBS_SHEET_NAME=Client Hubs
AUTH_REQUIRED=false
OTP_DEV_MODE=false
OTP_EXPIRY_MINUTES=10
SESSION_EXPIRY_HOURS=12
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_NAME=

# Alert condition: alert if previous-day movement is below either threshold.
ALERT_MIN_RUNNING_MINUTES=60
ALERT_MIN_DISTANCE_KM=1

# SMTP is required for real OTP and alert emails. Without it, alert send
# returns dry-run output and OTP codes are not delivered unless OTP_DEV_MODE=true.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Kyoto EV Fleet <no-reply@fitsol.green>

# Browser-visible Google Maps key. Restrict this key to your production domain
# and to the Maps JavaScript API in Google Cloud Console.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAP_ID=
